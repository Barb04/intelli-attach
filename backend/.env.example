# Copy this file to .env for local dev. Never commit the real .env.

NODE_ENV=development
PORT=4000

# Local Docker Postgres (Phase 0). Swap for Supabase/Neon connection string in prod.
DATABASE_URL=postgresql://intelliattach:localdevpass@localhost:5432/intelliattach

# JWT secrets — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Use two DIFFERENT secrets. If access and refresh share a secret, a leaked
# access token signing key also compromises refresh tokens.
JWT_ACCESS_SECRET=replace_me_with_a_64_byte_random_hex_value
JWT_REFRESH_SECRET=replace_me_with_a_different_64_byte_random_hex_value

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Comma-separated list of allowed frontend origins for CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login lockout policy
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
